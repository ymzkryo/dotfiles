#! /bin/bash

# ide - カレントディレクトリ名でウィンドウをリネームし、決まったレイアウトへ分割する
#
#   ide            4ペイン（左を広く取り、右を上下+横に割る）
#   ide 1          3ペイン（上 + 下を左右）
#   ide 2          4ペイン（左右 → それぞれ上下）
#   ide 3          2ペイン（上下）
#   ide main       3ペイン（左 + 右を上下）
#
#   ide restore    ide が作った比率へ戻す
#   ide save       今の比率を「ide の基準」として上書きする
#
# レイアウトを作ったあと、その時点の #{window_layout} を @ide_layout に保存する。
# restore はそれを select-layout で再適用する。select-layout は現在のウィンドウ
# サイズに合わせて比率を保ったままスケールするので、モニタを跨いでも崩れない。
#
# tmux-layout-keeper の @keep_layout とは役割が違うので別のキーに保存する。
# あちらは after-resize-pane フックで「今の良い比率」を追従し続けるため、
# LLM などがペインを広げるとその崩れた値で上書きされてしまう。
# @ide_layout は ide / ide save でしか書かないので、荒らされても残る。
#
# 【制約】ウィンドウオプションなので tmux サーバーを再起動すると消える。
#         tmux-resurrect はカスタムの @ オプションを保存しない（実測）。
#         再起動後は ide を叩き直せば基準が再生成される。

set -u

LAYOUT_OPT="@ide_layout"
PRESET_OPT="@ide_preset"

die() {
    echo "[ERROR] $1" >&2
    exit 1
}

require_tmux() {
    [ -n "${TMUX:-}" ] || die "tmux の中で実行してください。"
}

# 現在のレイアウトを基準として保存する
save_layout() {
    local preset=$1 layout
    layout=$(tmux display-message -p '#{window_layout}')
    tmux set-option -w "$LAYOUT_OPT" "$layout"
    tmux set-option -w "$PRESET_OPT" "$preset"
}

restore_layout() {
    local layout preset panes
    layout=$(tmux show-options -w -v "$LAYOUT_OPT" 2>/dev/null)

    if [ -z "$layout" ]; then
        die "このウィンドウには ide の基準レイアウトがありません。
        ide か ide <preset> で作り直すか、今の比率でよければ ide save を実行してください。"
    fi

    # select-layout はペイン数が違うと "have N panes but need M" で失敗する。
    # レイアウトは変更されないので害は無いが、理由が分かるように出す。
    if ! tmux select-layout "$layout" 2>/dev/null; then
        panes=$(tmux display-message -p '#{window_panes}')
        preset=$(tmux show-options -w -v "$PRESET_OPT" 2>/dev/null)
        die "ペイン構成が基準と違うため復元できません（現在 ${panes} ペイン）。
        ペインを閉じてから ide restore するか、ide ${preset:-} で作り直してください。"
    fi
}

require_tmux

# get current directory name
current_dir=$(basename "$(pwd)")

case "${1:-}" in
    restore)
        restore_layout
        exit 0
        ;;
    save)
        save_layout "$(tmux show-options -w -v "$PRESET_OPT" 2>/dev/null)"
        echo "[ide] 今の比率を基準として保存しました。"
        exit 0
        ;;
esac

if [ "$#" -eq 0 ]; then
    tmux rename-window "$current_dir"
    tmux split-window -h
    tmux select-pane -t 1
    tmux resize-pane -L 60
    tmux select-pane -t 2
    tmux split-window -v
    tmux select-pane -t 2
    tmux resize-pane -D 15
    tmux select-pane -t 3
    tmux split-window -h
    tmux select-pane -t 2
    save_layout default
else
  case $1 in
    1)
      tmux rename-window "$current_dir"
      tmux split-window -v
      tmux split-window -h
      tmux resize-pane -D 15
      tmux select-pane -t 1
      save_layout 1
      clear
      ;;
    2)
      tmux rename-window "$current_dir"
      tmux split-window -h
      tmux split-window -v
      tmux resize-pane -D 15
      tmux select-pane -t 1
      tmux split-window -v
      tmux select-pane -t 1
      save_layout 2
      clear
      ;;
    3)
      tmux rename-window "$current_dir"
      tmux split-window -v
      tmux resize-pane -D 15
      tmux select-pane -D
      save_layout 3
      clear
      ;;
    main)
      tmux rename-window main
      tmux split-window -h
      tmux select-pane -t 2
      tmux split-window -v
      tmux select-pane -t 1
      save_layout main
      clear
      ;;
    *)
      die "\"$1\" は設定されていない引数です。ide / ide 1 / ide 2 / ide 3 / ide main / ide restore / ide save"
      ;;
  esac
fi
